# Kopieren nach .env, Schluessel eintragen, fertig:
#   cp .env.beispiel .env

# Sitzungsschluessel. Einmal erzeugen und nie wieder aendern - eine Aenderung
# meldet alle Angemeldeten ab:
#   openssl rand -hex 32
FINANZ_SECRET_KEY=

# Nur fuer Entwickler: ein selbst gebautes Image statt dem aus der
# Registry, z.B. IMAGE=haushaltsfinanz mit TAG=test.
#IMAGE=ghcr.io/schlotti73/haushaltsfinanz

# Version. "latest" ist die neueste; fuer einen Rollback hier den alten Tag
# eintragen, etwa v1.4.2 - siehe docs/docker.md.
TAG=latest

# Port auf dem Host. Die App ist danach unter http://<server>:8000 erreichbar.
PORT=8000

# Zeitzone. Sie bestimmt, wann "02:00" fuer das Backup ist und auf welchen Tag
# eine Buchung faellt.
TZ=Europe/Berlin

# Benutzer, dem die Dateien unter ./daten gehoeren sollen. "id -u" und "id -g"
# auf dem Host zeigen die eigenen Werte.
PUID=1000
PGID=1000
